{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suncalc-app-preview",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
  },
  "vars": { "BILLING_MODE": "preview", "MAP_KEY": "20261118.pmtiles" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "suncalc-app-preview",
      "database_id": "f424c99f-7193-4146-bf6d-42d14fdb315a",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MAPS", "bucket_name": "suncalc-maps" }],
  "observability": { "enabled": false },
}
