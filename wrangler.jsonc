{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suncalc-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [{ "pattern": "suncalc.app", "custom_domain": true }],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/tiles/*"],
    "not_found_handling": "none",
  },
  "vars": { "BILLING_MODE": "preview", "MAP_KEY": "20261118.pmtiles" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "suncalc-app",
      "database_id": "1fa5c81f-e3fd-4006-a1cf-797201cde357",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MAPS", "bucket_name": "suncalc-maps" }],
  "workflows": [
    {
      "name": "suncalc-map-import",
      "binding": "IMPORT",
      "class_name": "MapImport",
    },
  ],
  "observability": { "enabled": false },
}
