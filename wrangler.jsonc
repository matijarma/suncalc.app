{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suncalc-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "suncalc.app", "custom_domain": true },
    { "pattern": "www.suncalc.app", "custom_domain": true },
    { "pattern": "sin.suncalc.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // The admin hostname must reach Access checks even for matching public assets.
    "run_worker_first": true,
    "not_found_handling": "none",
  },
  "vars": {
    "BILLING_MODE": "preview",
    "MAP_KEY": "20261118.pmtiles",
    "ACCESS_ISSUER": "https://kompmajstor.cloudflareaccess.com",
    "ACCESS_AUD": "bf149dab3546b8046e051eb30c4d3491cb40ba500b43800f69a2b740defa470e"
  },
  "triggers": { "crons": ["7,22,37,52 * * * *"] },
  "ratelimits": [{ "name": "ANDROID_LIMIT", "namespace_id": "69417206", "simple": { "limit": 60, "period": 60 } }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "suncalc-app",
      "database_id": "1fa5c81f-e3fd-4006-a1cf-797201cde357",
      "migrations_dir": "migrations",
    },
    {
      "binding": "USAGE_DB",
      "database_name": "suncalc-usage",
      "database_id": "1b59d389-32b0-42b2-bc45-9d310b67f08f",
      "migrations_dir": "migrations-usage",
    },
  ],
  "r2_buckets": [{ "binding": "MAPS", "bucket_name": "suncalc-maps" }],
  "workflows": [
    {
      "name": "suncalc-map-import",
      "binding": "IMPORT",
      "class_name": "MapImport",
    },
  ],
  "observability": { "enabled": false },
}
