{
  "name": "Canonical SunCalc URL",
  "rules": [
    {
      "ref": "suncalc_canonical_url",
      "description": "Use the HTTPS apex for public SunCalc URLs",
      "expression": "(http.host eq \"www.suncalc.app\") or (http.host eq \"suncalc.app\" and not ssl)",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "status_code": 308,
          "target_url": { "expression": "concat(\"https://suncalc.app\", http.request.uri.path)" },
          "preserve_query_string": true
        }
      },
      "enabled": true
    }
  ]
}
